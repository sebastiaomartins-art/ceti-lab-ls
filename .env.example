# ====== Banco de dados (Supabase) ======
# Crie o seu próprio projeto em https://supabase.com (gratuito)
# e cole aqui a URL e as chaves de Settings > API
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Variáveis públicas (precisam ficar também no Vite para o navegador)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="seu-project-ref"

# ====== Segurança do site ======
# Senha para entrar no site (qualquer pessoa da escola digita)
SITE_PASSWORD="CetiLab2026"

# Senha para EXCLUIR agendamentos (só a secretaria sabe)
ADMIN_PASSWORD="Landri26@"

# Chave secreta para criptografar a sessão (gere uma longa aleatória)
# Gere com:  openssl rand -hex 32
SESSION_SECRET="COLOQUE_AQUI_UMA_STRING_ALEATORIA_GRANDE"
